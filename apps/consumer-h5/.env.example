# 本地开发：/api/** 反向代理目标（consumer-bff）
# consumer-bff 默认端口 8087（见 backend services/consumer-bff/src/main/resources/application.yml）
CONSUMER_BFF_PROXY_TARGET=http://localhost:8087

# 仅在预发/子路径部署时使用；线上 https://app.su46proj.site/ 为根路径，保持不设置。
# MINIPAY_DEPLOY_BASE=/

# 可选：跨域部署时把 BFF 绝对地址注入前端（默认同源 /api，不需要设置）
# CONSUMER_BFF_PUBLIC_PATH=

# 提示：consumer-bff 默认 SESSION_COOKIE_SECURE=true，本地 http://localhost 调试
# 需要把该环境变量改成 false，否则浏览器不会保存会话 Cookie。
